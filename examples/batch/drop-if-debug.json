{
  "schema": "storygraph.batch/1",
  "rules": [
    {
      "id": "drop-if-debug",
      "when": {
        "code_contains": "debug_print"
      },
      "delete": {
        "scope": "beat",
        "match": {
          "mode": "exact",
          "pattern": "if DEBUG:"
        },
        "span": "block"
      }
    }
  ]
}
