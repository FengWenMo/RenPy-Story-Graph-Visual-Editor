# ==================================================================
#  Python
# ==================================================================
__pycache__/
*.py[cod]
*.egg-info/
.eggs/

# ==================================================================
#  测试 / 构建缓存
# ==================================================================
.pytest_cache/
# ftr（全量测试器）的基线/日志/中间产物（本机状态，不入库）
.ftr/
# 本机把 TMPDIR/TEMP 指到仓库内时，pip 与 pytest 会往这里写临时文件。
# 曾经有 9611 个临时文件被误提交进版本库（2026-09-28 清理）。
.pip-tmp/
# fasttest 的旧 basetemp 先 rename 到这里再由后台进程删；同盘 rename 是
# 瞬时的，避免每次开跑前花几分钟删 1.5 万个临时文件。
.fasttest-trash/
build_out/

# ==================================================================
#  生成产物（都能由命令重建，不该进版本库）
# ==================================================================
*.generated.rpy
*.blocked.rpy
*.export.xlsx
*.rpy.bak
# 探针产物（`tools/probe_*.py` 每次重建；里面常有几十 MB 的 xlsx / 日志）
tools/out_*/

# ==================================================================
#  PyInstaller 打包（exe 约 140 MB，绝不能进版本库）
# ==================================================================
# `build/` 是 PyInstaller 的中间目录；注意它同时是本项目默认的
# 「产物目录」名字，所以这里只忽略 `build/storygraph/`（打包中间产物），
# 别的 build/ 子目录（例如 demo/build/）是**要提交**的示例产物。
build/storygraph/
build/*.toc
build/*.pkg
build/*.pyz
dist/
# 交付用的另一份打包目录（`--distpath dist_release`）与给它打的 zip
# （2026-10-21：152 MB 的 exe + 68 MB 的 zip，都可由 packaging 重建）
dist_release*/
/StoryGraph-*.zip
# 带日期的交付目录（`--distpath StoryGraph-1.0.0-win64-2026-10-21`，151 MB 的
# exe 与 _internal/，同样可由 packaging 重建）
/StoryGraph-*-win64*/
# PyInstaller 的中间目录（`--workpath build/release`）
build/release*/
# 2026-10-26 重打包用的新目录：沙箱的"批量删除守卫"会拦下 PyInstaller
# 覆盖 dist/StoryGraph 的动作（要删 240 个文件），所以改用全新输出目录，
# 避开删除。内容与 dist/ 等价，可由 packaging 重建。
dist_new/
build/pack/
# 2026-10-28 重打包前挪走的旧产物（`mv dist dist_old_20261028`）。
# ⚠ 想原地重建时，**别用 shell 的 `rm -rf dist/StoryGraph`** —— 同样会被
# 那个守卫拦（一次 227 个文件），然后 PyInstaller 拿到半旧目录。
# 用 Python 删：`python -c "import shutil;shutil.rmtree('dist/StoryGraph')"`
dist_old_*/
*.spec.bak

# ==================================================================
#  协作后端（每台机器 / 每个部署各自一份）
# ==================================================================
collab.db
collab.db-journal

# ==================================================================
#  编辑器 / 操作系统
# ==================================================================
.idea/
Thumbs.db
desktop.ini

# ==================================================================
#  本机备份 / 探针中间产物（各自机器上的一时之物，不进版本库）
# ==================================================================
# `.workbuddy/backup/`：改大模块前手抄的一份"撤回点"（谁改谁留，勿提交）。
# `presets/*.bak-<日期>`：同类的预设快照。
# `docs/shots/mod_probe/`：探针中间截图（结论写进 docs/*.md，图不留）。
.workbuddy/backup/
storygraph/presets/*.bak-*
docs/shots/mod_probe/
